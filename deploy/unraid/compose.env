# Hikidashi under Unraid's Compose Manager plugin, the alternative to the
# Community Applications templates beside this file (docs/install-unraid.md).
# Copy it to the checkout's .env, beside docker-compose.yml. The stack itself
# is one of the folders in compose-manager/, which read this .env.

# The database, media and models, on a pool. Never /mnt/user: SQLite on that
# FUSE share can be corrupted, even when the share is on the cache.
HIKIDASHI_DATA=/mnt/cache/appdata/hikidashi

# Unraid's nobody:users, so appdata is not root-owned.
HIKIDASHI_USER=99:100

# The web UI's port on the server.
HIKIDASHI_PORT=8080

# The release of the published images (#77), as 0.19.0. Unset, latest. Its
# remote workers run the same one.
# HIKIDASHI_VERSION=

# Accounts: none (everyone is the owner), local or proxy. local prints a
# setup link in the server's log on its first start.
HIKIDASHI_AUTH=none

# The layout. The stack's folder picks which containers run; this file sets
# what they do. Pick one:
#
# 1. Everything here, the stack on compose-manager/everything: the server,
#    its worker, and a worker on the CPU for transcripts, text on screen,
#    tags and recipes. Tags and recipes need an Ollama: Unraid's Ollama app,
#    reached through the host.
HIKIDASHI_OLLAMA_URL=http://host.docker.internal:11434
#
# 2. The same, with no Ollama here: transcripts and text on screen only.
# HIKIDASHI_LOCAL_STAGES=asr,ocr
#
# 3. The heavy work on a GPU desktop (docs/remote-workers.md), the stack on
#    compose-manager/server-only: no worker here at all. Make the desktop a
#    worker token on the Pipeline page. Not COMPOSE_FILE, which the plugin
#    never reads.

# Cores each worker may use, so the server stays responsive. 0: no limit.
HIKIDASHI_WORKER_CPUS=2
