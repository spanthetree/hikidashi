// Grafana Alloy: tail Hikidashi's log files into Loki, instead of
// HIKIDASHI_LOKI_URL (#149; docs/operation.md#logging). For anyone already
// running Alloy. Mount the data folder's logs/ at /data/logs, read-only.
local.file_match "hikidashi" {
  path_targets = [{"__path__" = "/data/logs/*.log", "app" = "hikidashi"}]
}

loki.source.file "hikidashi" {
  targets    = local.file_match.hikidashi.targets
  forward_to = [loki.relabel.hikidashi.receiver]
}

// server.log, worker.log, server-worker.log: the same `process` label the
// built-in push uses, and not the whole path.
loki.relabel "hikidashi" {
  forward_to = [loki.write.default.receiver]
  rule {
    source_labels = ["filename"]
    regex         = ".*/([^/]+)\\.log"
    target_label  = "process"
  }
  rule {
    action = "labeldrop"
    regex  = "filename"
  }
}

loki.write "default" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}
