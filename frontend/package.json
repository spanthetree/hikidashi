{
  "name": "hikidashi-web",
  "private": true,
  "version": "0.18.7",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "check": "npm run i18n && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "e2e": "npm run build && playwright test",
    "i18n": "paraglide-js compile --project ./project.inlang --outdir ./src/lib/paraglide --strategy custom-saved preferredLanguage baseLocale --silent"
  },
  "devDependencies": {
    "@fontsource/audiowide": "5.3.0",
    "@fontsource/dotgothic16": "5.3.0",
    "@fontsource/exo-2": "5.3.0",
    "@fontsource/jost": "5.3.0",
    "@fontsource/orbitron": "5.3.0",
    "@fontsource/pixelify-sans": "5.3.0",
    "@fontsource/press-start-2p": "5.3.0",
    "@fontsource/rajdhani": "5.3.0",
    "@fontsource/righteous": "5.3.0",
    "@inlang/paraglide-js": "2.25.4",
    "@inlang/plugin-message-format": "4.4.5",
    "@playwright/test": "1.64.0",
    "@sveltejs/adapter-static": "3.0.10",
    "@sveltejs/kit": "2.70.3",
    "@sveltejs/vite-plugin-svelte": "5.1.1",
    "@types/leaflet": "1.9.20",
    "@types/leaflet.markercluster": "1.5.5",
    "@types/node": "20.19.43",
    "@vitest/coverage-v8": "3.2.7",
    "fast-check": "4.10.2",
    "leaflet": "1.9.4",
    "leaflet.markercluster": "1.5.3",
    "svelte": "5.57.2",
    "svelte-check": "4.7.7",
    "typescript": "5.9.3",
    "vite": "6.4.5",
    "vitest": "3.2.7"
  },
  "engines": {
    "node": ">=20"
  }
}
