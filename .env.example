# Copy to .env and adjust. Everything has a working default. Compose reads it
# under Docker, and ./hikidashi hands it to uv (as UV_ENV_FILE) under uv; a
# variable set in the shell wins over this file in both.

# Docker: the host folder mounted at /data, for the database, media and models.
# On a local disk, as SQLite over NFS, SMB or FUSE can corrupt. Unraid: a pool,
# such as /mnt/cache/appdata/hikidashi, never /mnt/user. uv: the paths below.
HIKIDASHI_DATA=./data
# Docker: the user the containers write it as. Root unless set; a NAS's own
# user, so its appdata isn't root-owned: 99:100 on Unraid, 568:568 on TrueNAS.
# A library first written as root needs `chown -R` to the new user first.
# HIKIDASHI_USER=99:100
HIKIDASHI_DB=data/hikidashi.sqlite3
HIKIDASHI_MEDIA=data/media
HIKIDASHI_IMPORTS=data/imports
# Whisper weights, downloaded on first run (~330 MB cpu, ~1.5 GB cuda).
HIKIDASHI_MODELS=data/models

# The worker's models. auto | cpu | cuda. auto picks cuda when CTranslate2 can
# see a GPU.
#   cpu   distil-small.en at int8, four workers
#   cuda  distil-large-v3 at float16; needs `uv sync --extra worker --extra cuda`
#   The tagger follows it: qwen2.5:3b on cpu, qwen2.5:7b on cuda.
HIKIDASHI_PROFILE=auto
# The Ollama a worker tags and finds recipes with; the server never calls it.
# Two names, one per mode, since localhost inside a container is the
# container itself.
#   uv      OLLAMA_URL, read by the worker
#   Docker  HIKIDASHI_OLLAMA_URL, read by compose for the worker container.
#           Unset: the ollama service (--ai) in docker-compose.yml, the host's
#           own Ollama in docker-compose.worker.yml.
OLLAMA_URL=http://localhost:11434
HIKIDASHI_OLLAMA_URL=
# Where ./hikidashi start listens, under uv and Docker alike.
HIKIDASHI_HOST=0.0.0.0
HIKIDASHI_PORT=8080
# Who can use it. none: nobody signs in and everyone shares one library, as on
# localhost. local: accounts with passwords, each with a library of its own.
# proxy: a proxy in front (Authelia, Tailscale, Cloudflare Access) signs people
# in and names them in HIKIDASHI_PROXY_HEADER. The README has the details.
HIKIDASHI_AUTH=none
# Where browsers reach it, when a proxy in front changes the Host header.
# https:// here also makes the sign-in cookie Secure.
HIKIDASHI_ORIGIN=
# proxy mode only. The header is believed only from these addresses; under
# Docker that is the proxy's address on the Docker network, not 127.0.0.1.
HIKIDASHI_PROXY_HEADER=Remote-User
HIKIDASHI_TRUSTED_PROXIES=127.0.0.1/32,::1/128
# 1: a name the proxy sends with no account gets one. Unset: it is refused.
HIKIDASHI_PROXY_CREATES=
# Where places are looked up, by the server as reels arrive, `./hikidashi
# places` and the map's city search: a Nominatim server, or `public` for
# OpenStreetMap's, one place a second. Empty: nothing is looked up, and the map
# stays empty. Captions' places are sent to it, so it is off until you choose.
HIKIDASHI_GEOCODER=
HIKIDASHI_GEOCODER_DELAY=1
# Seconds between the server's looks for new places. 0: only ./hikidashi places.
HIKIDASHI_LOCATE_EVERY=300
# Map tiles, which the browser fetches. Empty: OpenStreetMap's, with its credit.
HIKIDASHI_TILES=
HIKIDASHI_TILES_ATTRIBUTION=
# The workers, which run the pipeline on new reels as they arrive. Which
# stages each runs: all, none, or a list such as asr,ocr.
#   uv      HIKIDASHI_LOCAL_STAGES, for the one worker. Unset: all.
#   Docker  HIKIDASHI_LOCAL_STAGES for the worker container (unset: asr, ocr,
#           tag and recipe; asr,ocr leaves tagging to a GPU desktop), and
#           HIKIDASHI_SERVER_STAGES for server-worker (unset: enrich,embed).
HIKIDASHI_LOCAL_STAGES=
HIKIDASHI_SERVER_STAGES=
# Their names in ./hikidashi status. Each worker on one database needs its own.
# Unset: the host's name (Docker: hikidashi-worker, hikidashi-server-worker).
HIKIDASHI_WORKER_NAME=
HIKIDASHI_SERVER_WORKER_NAME=
# Seconds with no work before it unloads Whisper and the embedder.
HIKIDASHI_UNLOAD_AFTER=300
# Docker only: the cores each worker may use. 0: no limit.
HIKIDASHI_WORKER_CPUS=2

# Remote workers (docs/remote-workers.md): a GPU desktop transcribing and
# tagging for a server elsewhere.
# On the desktop: the worker token it presents. An admin makes one on the
# server's Pipeline page, or there with `hikidashi token make <name> --worker`.
# The server itself takes no token from here.
HIKIDASHI_WORKER_TOKEN=
# On the desktop: the server it works for, as http://nas.lan:8080, and the
# token above. Set, `hikidashi worker` works for that server instead of a
# database here (docker-compose.worker.yml under Docker).
HIKIDASHI_SERVER=
# On the desktop: where the media it downloads are kept, up to 2 GB.
HIKIDASHI_CACHE=data/cache
# Docker, on a server whose ASR, OCR, tagging and recipes are all done by a
# worker on another machine: no worker container here, nor its image.
#COMPOSE_FILE=docker-compose.yml:docker-compose.server-only.yml
# uv | docker. Unset, ./hikidashi picks docker if the container exists.
HIKIDASHI_MODE=
# Docker only: the release of the published images to run (#77), as 1.2.3.
# Unset, latest. A tag nobody published, as dev, keeps the images you build
# here with ./hikidashi start --build: starting then never pulls over them.
#HIKIDASHI_VERSION=
# Docker only: the worker image. hikidashi-worker-cuda on a GPU host (and
# uncomment the worker's deploy block in docker-compose.yml). Unset,
# docker-compose.yml runs hikidashi-worker and docker-compose.worker.yml, for
# a GPU desktop, hikidashi-worker-cuda.
#HIKIDASHI_WORKER_IMAGE=hikidashi-worker-cuda
# Docker builds only: "--extra cuda" builds the worker image with the GPU
# libraries. Unset, docker-compose.yml builds without them and
# docker-compose.worker.yml with them; set to nothing there for the CPU image.
#HIKIDASHI_EXTRAS=--extra cuda
